<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EBI Executive Control Panel</title>
    <!-- CSS Bootstrap 5 / FontAwesome untuk UI Modern -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <style>
        body { background-color: #f4f6f9; font-family: 'Inter', system-ui, sans-serif; }
        .sidebar-ebi { width: 260px; height: 100vh; position: fixed; background: #1e293b; color: #fff; z-index: 1000; }
        .main-content { margin-left: 260px; padding: 20px; }
        .nav-link-ebi { color: #94a3b8; padding: 12px 20px; display: block; text-decoration: none; border-radius: 8px; margin: 4px 12px; }
        .nav-link-ebi:hover, .nav-link-ebi.active { background: #334155; color: #38bdf8; }
        .top-panel { background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 15px 20px; margin-bottom: 20px; border-radius: 12px; }
    </style>
</head>
<body>

    <!-- Sidebar Kustom EBI -->
    <div class="sidebar-ebi shadow">
        <div class="p-3 text-center border-bottom border-secondary">
            <h5 class="fw-bold text-white mb-0">EBI CONTROL PANEL</h5>
            <small class="text-info">LMS Management System</small>
        </div>
        <div class="mt-3">
            <a href="index.php?tab=map" class="nav-link-ebi {{#is_map}}active{{/is_map}}">
                <i class="fa-solid fa-diagram-project me-2"></i> Course Map
            </a>
            <a href="index.php?tab=plugins" class="nav-link-ebi {{#is_plugins}}active{{/is_plugins}}">
                <i class="fa-solid fa-heart-pulse me-2"></i> Health Check
            </a>
            <a href="index.php?tab=activity" class="nav-link-ebi {{#is_activity}}active{{/is_activity}}">
                <i class="fa-solid fa-chart-line me-2"></i> Activity Monitor
            </a>
        </div>
    </div>

    <!-- Area Konten Utama -->
    <div class="main-content">
        <!-- Top Bar dengan Tombol-Tombol Kustom -->
        <div class="top-panel d-flex justify-content-between align-items-center shadow-sm">
            <div>
                <h4 class="fw-bold mb-0 text-dark">{{page_title}}</h4>
                <small class="text-muted">Panel Pemantauan Executive Perusahaan EBI</small>
            </div>
            <div>
                <!-- Contoh Tombol-Tombol Kustom -->
                <button class="btn btn-outline-secondary me-2" onclick="location.reload();">
                    <i class="fa-solid fa-rotate me-1"></i> Refresh Data
                </button>
                <a href="{{config.wwwroot}}/admin/search.php" class="btn btn-dark">
                    <i class="fa-solid fa-arrow-left me-1"></i> Kembali ke Moodle
                </a>
            </div>
        </div>

        <!-- Render Isi Tab Sesuai Pilihan -->
        <div class="content-body">
            {{{tab_content}}}
        </div>
    </div>

</body>
</html>