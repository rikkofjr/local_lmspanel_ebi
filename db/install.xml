<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/lmspanel_ebi/db" VERSION="2026101901" COMMENT="XMLDB file for EBI LMS Panel with _ebi suffix">
  <TABLES>
    <!-- Tabel pengaturan dan cache layout panel EBI -->
    <TABLE NAME="local_lmspanel_config_ebi" COMMENT="Menyimpan pengaturan kustom panel EBI">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="100" NOTNULL="true" COMMENT="Nama konfigurasi"/>
        <FIELD NAME="value" TYPE="text" NOTNULL="false" COMMENT="Nilai konfigurasi (JSON/String)"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>

    <!-- Contoh tabel tambahan untuk masa depan: Menyimpan log aktivitas/snapshot -->
    <TABLE NAME="local_lmspanel_log_ebi" COMMENT="Menyimpan rekam jejak aktivitas penting pada panel EBI">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="ID Admin/Manager yang melakukan aksi"/>
        <FIELD NAME="action" TYPE="char" LENGTH="100" NOTNULL="true" COMMENT="Jenis aksi"/>
        <FIELD NAME="details" TYPE="text" NOTNULL="false" COMMENT="Detail tambahan"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>